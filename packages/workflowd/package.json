{
  "type": "module",
  "name": "@oh-my-pi/workflowd",
  "version": "17.1.2",
  "private": true,
  "description": "Shared authoritative workflow coordinator for ZZ coding tasks",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "zz-workflowd": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "check": "biome check . && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "test": "bun test",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write ."
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  }
}
